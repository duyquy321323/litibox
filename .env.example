# ==============================================================
#  Cấu hình hạ tầng cho Docker Compose
#  File .env được scripts/bootstrap_env.sh tự sinh từ file này.
#  Nếu file .env đã tồn tại thì script KHÔNG ghi đè -> cứ sửa .env.
# ==============================================================

# ---------- Cổng truy cập trên máy host ----------
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Dùng 3307 để tránh trùng với MySQL cài sẵn trên máy
MYSQL_PORT=3307

# ---------- MySQL ----------
MYSQL_DATABASE=btl
MYSQL_USER=btl
# 2 giá trị dưới đây được sinh ngẫu nhiên ở lần chạy đầu tiên
MYSQL_PASSWORD=__GENERATE_MYSQL_PASSWORD__
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__

# ---------- Backend ----------
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0
RUN_MIGRATIONS=true
# Thêm origin của frontend khi đổi port hoặc deploy domain thật
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Frontend ----------
# URL mà TRÌNH DUYỆT dùng để gọi API (phải là địa chỉ truy cập được từ máy host)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL mà SERVER Next.js dùng để gọi API trong mạng nội bộ Docker
API_INTERNAL_URL=http://backend:8000
