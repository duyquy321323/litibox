# ==============================================================
#  Cấu hình riêng của backend (được nạp qua env_file trong compose)
#  File backend/.env được scripts/bootstrap_env.sh tự sinh từ file này.
#  KHÔNG commit backend/.env (đã nằm trong .gitignore).
# ==============================================================

# ---------- App ----------
APP_NAME=BTL API
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0
API_PREFIX=/api
SECRET_KEY=__GENERATE_SECRET_KEY__

# Origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tự chạy `alembic upgrade head` khi container khởi động
RUN_MIGRATIONS=true

# ==============================================================
#  Thông tin MySQL: khi chạy bằng Docker, compose tự truyền các biến
#  MYSQL_* từ .env ở thư mục gốc. Các dòng dưới chỉ dùng khi bạn chạy
#  backend trực tiếp trên máy (python -m uvicorn app.main:app).
# ==============================================================
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=btl
# MYSQL_PASSWORD=btlpassword
# MYSQL_DATABASE=btl
# DATABASE_URL=mysql+pymysql://btl:btlpassword@127.0.0.1:3307/btl?charset=utf8mb4

# ==============================================================
#  BIẾN CẦN BẠN TỰ ĐIỀN SAU (để trống nếu chưa dùng)
#  Điền xong chạy lại: ./start.sh
# ==============================================================

# --- Gửi email (xác thực tài khoản, quên mật khẩu) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# --- Thanh toán VNPay ---
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Thanh toán MoMo ---
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=

# --- Đăng nhập Google / Facebook ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Lưu file / ảnh sản phẩm (S3, Cloudinary...) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
